	})
end

killBtn.MouseButton1Click:Connect(function()
	local Target = gplr(box.Text)
	if not Target[1] then return end
	local Player = Target[1]
	local LocalPlayer = lp

	if LocalPlayer.Character and LocalPlayer.Character.PrimaryPart then
		local Character = LocalPlayer.Character
		local prev = Character.PrimaryPart.CFrame

		Character.Archivable = true
		local Clone = Character:Clone()
		LocalPlayer.Character = Clone
		task.wait(0.5)
		LocalPlayer.Character = Character
		task.wait(0.2)

		if Player.Character and Player.Character.PrimaryPart then
			if Character:FindFirstChildOfClass("Humanoid") then
				Character:FindFirstChildOfClass("Humanoid"):Destroy()
			end

			local newHum = Instance.new("Humanoid")
			newHum.Parent = Character

			local Tool = Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
			if Tool then
				Tool.Parent = LocalPlayer.Backpack
				Player.Character.PrimaryPart.Anchored = true

				local hand = Character:FindFirstChild("RightHand") or Character:FindFirstChild("Right Arm")
				if hand then
					local offset = CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)
					local gripCFrame = hand.CFrame * offset
					Tool.Grip = gripCFrame:ToObjectSpace(Player.Character.PrimaryPart.CFrame):Inverse()
					Tool.Parent = Character
					workspace.CurrentCamera.CameraSubject = Tool:FindFirstChild("Handle") or Tool
				end

				repeat wait() until not Tool or Tool.Parent == workspace or Tool.Parent == Player.Character
				Player.Character.PrimaryPart.Anchored = false
				task.wait(0.1)
				newHum.Health = 0
				LocalPlayer.Character = nil

				spawn(function()
					LocalPlayer.CharacterAdded:Wait()
					Player.Character.PrimaryPart.Anchored = false
					if Player.Character:FindFirstChildOfClass("Humanoid").Health <= 15 then
						notif("The requested user has been killed!")
						repeat task.wait() until LocalPlayer.Character.PrimaryPart
						task.wait(0.4)
						LocalPlayer.Character:SetPrimaryPartCFrame(prev)
					end
				end)
			end
		end
	end
end)

